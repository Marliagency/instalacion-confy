{
  "_meta": {
    "descripcion": "WAN 2.2 image-to-video NATIVO (formato API) VALIDADO el 2026-06-02 sobre hearmeman/comfyui-wan-template:v19. Cubre los formatos cinematic / pov_phone / product (cambia el prompt, no el grafo). Dos expertos MoE (high/low) + LoRAs lightx2v (muestreo 4 pasos, 2+2). Los nombres de modelos están atados a esa imagen del pod: ejecuta comfy_doctor.py para verificar que existen tras arrancar.",
    "inject": {
      "image":    [["11", "image"]],
      "positive": [["8", "text"]],
      "negative": [["9", "text"]],
      "width":    [["12", "width"]],
      "height":   [["12", "height"]],
      "length":   [["12", "length"]],
      "seed":     [["13", "noise_seed"], ["14", "noise_seed"]],
      "prefix":   [["16", "filename_prefix"]]
    },
    "modelos_requeridos": {
      "unet": ["wan2.2_i2v_high_noise_14B_fp16.safetensors", "wan2.2_i2v_low_noise_14B_fp16.safetensors"],
      "loras": ["i2v_lightx2v_high_noise_model.safetensors", "i2v_lightx2v_low_noise_model.safetensors"],
      "clip": ["umt5_xxl_fp8_e4m3fn_scaled.safetensors"],
      "vae": ["wan_2.1_vae.safetensors"]
    }
  },
  "1":  {"class_type": "UNETLoader", "inputs": {"unet_name": "wan2.2_i2v_high_noise_14B_fp16.safetensors", "weight_dtype": "default"}},
  "2":  {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "i2v_lightx2v_high_noise_model.safetensors", "strength_model": 1.0}},
  "3":  {"class_type": "ModelSamplingSD3", "inputs": {"model": ["2", 0], "shift": 8.0}},
  "4":  {"class_type": "UNETLoader", "inputs": {"unet_name": "wan2.2_i2v_low_noise_14B_fp16.safetensors", "weight_dtype": "default"}},
  "5":  {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["4", 0], "lora_name": "i2v_lightx2v_low_noise_model.safetensors", "strength_model": 1.0}},
  "6":  {"class_type": "ModelSamplingSD3", "inputs": {"model": ["5", 0], "shift": 8.0}},
  "7":  {"class_type": "CLIPLoader", "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan"}},
  "8":  {"class_type": "CLIPTextEncode", "inputs": {"text": "PLACEHOLDER_POSITIVE", "clip": ["7", 0]}},
  "9":  {"class_type": "CLIPTextEncode", "inputs": {"text": "blurry, low quality, distorted, watermark, text", "clip": ["7", 0]}},
  "10": {"class_type": "VAELoader", "inputs": {"vae_name": "wan_2.1_vae.safetensors"}},
  "11": {"class_type": "LoadImage", "inputs": {"image": "PLACEHOLDER.png"}},
  "12": {"class_type": "WanImageToVideo", "inputs": {"positive": ["8", 0], "negative": ["9", 0], "vae": ["10", 0], "width": 480, "height": 832, "length": 81, "batch_size": 1, "start_image": ["11", 0]}},
  "13": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["3", 0], "add_noise": "enable", "noise_seed": 0, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["12", 0], "negative": ["12", 1], "latent_image": ["12", 2], "start_at_step": 0, "end_at_step": 2, "return_with_leftover_noise": "enable"}},
  "14": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["6", 0], "add_noise": "disable", "noise_seed": 0, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["12", 0], "negative": ["12", 1], "latent_image": ["13", 0], "start_at_step": 2, "end_at_step": 4, "return_with_leftover_noise": "disable"}},
  "15": {"class_type": "VAEDecode", "inputs": {"samples": ["14", 0], "vae": ["10", 0]}},
  "16": {"class_type": "VHS_VideoCombine", "inputs": {"images": ["15", 0], "frame_rate": 16, "loop_count": 0, "filename_prefix": "seg", "format": "video/h264-mp4", "pingpong": false, "save_output": true}}
}
