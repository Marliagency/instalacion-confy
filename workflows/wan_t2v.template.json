{
  "_NOTA": "PLANTILLA ESTRUCTURAL — NO la uses tal cual. Los nombres de modelos/nodos de WAN dependen de tu pod. Exporta el workflow real desde la UI de ComfyUI (engranaje -> Enable Dev mode Options -> Save (API Format)) y guárdalo como workflows/wan_t2v.json. Esta plantilla solo sirve para que comfy_batch.py --dry-run valide la detección de nodos.",
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_t2v_REEMPLAZAR.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load WAN UNet (REEMPLAZAR)" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "umt5_xxl_REEMPLAZAR.safetensors", "type": "wan" },
    "_meta": { "title": "Load CLIP (REEMPLAZAR)" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan_vae_REEMPLAZAR.safetensors" },
    "_meta": { "title": "Load VAE (REEMPLAZAR)" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "PLACEHOLDER POSITIVE PROMPT", "clip": ["2", 0] },
    "_meta": { "title": "Positive Prompt" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, low quality, distorted, static, watermark", "clip": ["2", 0] },
    "_meta": { "title": "Negative Prompt" }
  },
  "5": {
    "class_type": "EmptyHunyuanLatentVideo",
    "inputs": { "width": 480, "height": 832, "length": 81, "batch_size": 1 },
    "_meta": { "title": "Empty Latent Video (9:16, ~5s)" }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 12345,
      "steps": 30,
      "cfg": 6,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "_meta": { "title": "KSampler" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["3", 0] },
    "_meta": { "title": "VAE Decode" }
  },
  "12": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "batch_video",
      "format": "video/h264-mp4",
      "images": ["11", 0]
    },
    "_meta": { "title": "Video Combine (MP4)" }
  }
}
