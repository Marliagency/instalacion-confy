{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "wan2.2_t2v_high_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"},
    "_meta": {"title": "WAN t2v HIGH noise"}
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "wan2.2_t2v_low_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"},
    "_meta": {"title": "WAN t2v LOW noise"}
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan"},
    "_meta": {"title": "Load CLIP (umt5 wan)"}
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "wan_2.1_vae.safetensors"},
    "_meta": {"title": "Load VAE (wan 2.1, 16ch)"}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "PLACEHOLDER POSITIVE PROMPT", "clip": ["3", 0]},
    "_meta": {"title": "Positive Prompt"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "blurry, low quality, distorted, static, watermark, app interface, phone screen ui, text overlay, deformed hands", "clip": ["3", 0]},
    "_meta": {"title": "Negative Prompt"}
  },
  "7": {
    "class_type": "EmptyHunyuanLatentVideo",
    "inputs": {"width": 480, "height": 832, "length": 81, "batch_size": 1},
    "_meta": {"title": "Empty Latent Video (9:16, ~5s)"}
  },
  "8": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"shift": 8.0, "model": ["1", 0]},
    "_meta": {"title": "ModelSampling HIGH"}
  },
  "9": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"shift": 8.0, "model": ["2", 0]},
    "_meta": {"title": "ModelSampling LOW"}
  },
  "10": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "enable", "noise_seed": 12345, "steps": 20, "cfg": 3.5,
      "sampler_name": "euler", "scheduler": "simple",
      "start_at_step": 0, "end_at_step": 10, "return_with_leftover_noise": "enable",
      "model": ["8", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0]
    },
    "_meta": {"title": "KSampler HIGH (0-10)"}
  },
  "11": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "disable", "noise_seed": 12345, "steps": 20, "cfg": 3.5,
      "sampler_name": "euler", "scheduler": "simple",
      "start_at_step": 10, "end_at_step": 10000, "return_with_leftover_noise": "disable",
      "model": ["9", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["10", 0]
    },
    "_meta": {"title": "KSampler LOW (10-end)"}
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["11", 0], "vae": ["4", 0]},
    "_meta": {"title": "VAE Decode"}
  },
  "13": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "frame_rate": 16, "loop_count": 0, "filename_prefix": "qyro",
      "format": "video/h264-mp4", "pix_fmt": "yuv420p", "crf": 19,
      "save_metadata": true, "pingpong": false, "save_output": true,
      "images": ["12", 0]
    },
    "_meta": {"title": "Video Combine (MP4)"}
  }
}
