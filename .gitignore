# Videos generados y reportes del lote
outputs/

# Prompts del lote en curso (se regeneran en cada producción)
batch_prompts.json

# Nota: los workflows en workflows/ SÍ se versionan (plantillas + el real que
# exportes). Si tu wan_t2v.json real es enorme y no lo quieres en git, ignóralo:
# workflows/wan_t2v.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secretos — NUNCA subir claves
.env
*.key

# Artefactos temporales de orquestación (reintento de pod)
.retry_pod.py
.pod_result.json

# Content Engine: salidas pesadas y estado autogenerado por semana.
# Se versionan plan.json / intencion.json / calendario.csv (texto, ilustrativos)
# pero NO los frames, vídeos, manifiesto ni audios de entrada.
content-engine/semanas/*/generated/
content-engine/semanas/*/edited/
content-engine/semanas/*/manifest.json
content-engine/semanas/*/inputs/audio/*
!content-engine/semanas/*/inputs/audio/.gitkeep

# Marli: salidas de anuncios (vídeos/imágenes generados) — no versionar.
marli/outputs/
