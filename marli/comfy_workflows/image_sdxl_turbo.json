{
  "_NOTA": "Workflow REAL SDXL-Turbo (no-gated) para fondos de text card / slideshow cuando no haya FLUX. Generación rápida (4 pasos, cfg 1). El orquestador parchea positive/negative, EmptyLatentImage width/height y KSampler.seed.",
  "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "SDXL-TURBO/sd_xl_turbo_1.0_fp16.safetensors"}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}, "_meta": {"title": "positive"}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}, "_meta": {"title": "negative"}},
  "5": {"class_type": "EmptyLatentImage", "inputs": {"width": 832, "height": 1216, "batch_size": 1}},
  "3": {"class_type": "KSampler", "inputs": {"seed": 42, "steps": 5, "cfg": 1.2, "sampler_name": "euler_ancestral", "scheduler": "sgm_uniform", "denoise": 1.0, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
  "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "marli_turbo", "images": ["8", 0]}}
}
